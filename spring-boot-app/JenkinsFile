
pipeline {

    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_IMAGE = 'shaunjohnmathew/spring-boot-app'
        GIT_USER_NAME = 'shaunjohn-04'
        GIT_REPO_NAME = 'java-maven-sonar-argocd'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================='
                echo 'Checking out source code'
                echo '========================================='

                checkout scm

                sh '''
                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Project files:"
                    ls -la

                    echo ""
                    echo "Spring Boot project:"
                    ls -la spring-boot-app

                    echo ""
                    echo "Kubernetes manifests:"
                    ls -la spring-boot-app-manifests
                '''
            }
        }

        stage('Build and Test') {
            steps {
                echo '========================================='
                echo 'Building Spring Boot application'
                echo '========================================='

                sh '''
                    set -e

                    cd spring-boot-app

                    echo "Maven version:"
                    mvn --version

                    echo ""
                    echo "Building application..."

                    mvn clean package

                    echo ""
                    echo "Build completed successfully."

                    echo ""
                    echo "Generated JAR files:"
                    ls -lh target/
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '========================================='
                echo 'Running SonarQube Analysis'
                echo '========================================='

                withSonarQubeEnv('sonarqube') {
                    sh '''
                        set -e

                        cd spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                            -Dsonar.projectKey=spring-boot-app \
                            -Dsonar.projectName="Spring Boot App" \
                            -Dsonar.host.url="$SONAR_HOST_URL"

                        echo ""
                        echo "SonarQube analysis completed successfully."
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '========================================='
                echo 'Building Docker Image'
                echo '========================================='

                sh '''
                    set -e

                    echo "Building Docker image..."

                    docker build \
                        -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                        -t ${DOCKER_IMAGE}:latest \
                        spring-boot-app

                    echo ""
                    echo "Docker image built successfully."

                    echo ""
                    echo "Docker images:"
                    docker images | grep spring-boot-app || true
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                echo '========================================='
                echo 'Pushing Docker Image'
                echo '========================================='

                script {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'docker-cred',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "Logging in to Docker Hub..."

                            echo "$DOCKER_PASSWORD" | docker login \
                                -u "$DOCKER_USERNAME" \
                                --password-stdin

                            echo ""
                            echo "Pushing version ${BUILD_NUMBER}..."

                            docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                            echo ""
                            echo "Pushing latest..."

                            docker push ${DOCKER_IMAGE}:latest

                            echo ""
                            echo "Logging out from Docker Hub..."

                            docker logout

                            echo ""
                            echo "Docker images pushed successfully."
                        '''
                    }
                }
            }
        }

        stage('Update Kubernetes Deployment') {
            steps {

                echo '========================================='
                echo 'Updating Kubernetes Deployment'
                echo '========================================='

                script {

                    /*
                     * IMPORTANT:
                     *
                     * github-credentials is a
                     * "Username with password" credential.
                     *
                     * Therefore we MUST use usernamePassword()
                     * instead of string().
                     */

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-credentials',
                            usernameVariable: 'GITHUB_USERNAME',
                            passwordVariable: 'GITHUB_TOKEN'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "Current directory:"
                            pwd

                            echo ""
                            echo "Git status:"
                            git status

                            echo ""
                            echo "Deployment before update:"
                            cat spring-boot-app-manifests/deployment.yml

                            echo ""
                            echo "Updating Docker image..."

                            sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                                spring-boot-app-manifests/deployment.yml

                            echo ""
                            echo "Deployment after update:"
                            cat spring-boot-app-manifests/deployment.yml

                            echo ""
                            echo "Configuring Git..."

                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"

                            echo ""
                            echo "Adding deployment file..."

                            git add spring-boot-app-manifests/deployment.yml

                            echo ""
                            echo "Checking for changes..."

                            if git diff --cached --quiet; then

                                echo "No changes to commit."

                            else

                                echo ""
                                echo "Committing deployment update..."

                                git commit \
                                    -m "Update Spring Boot image tag to ${BUILD_NUMBER} [skip ci]"

                                echo ""
                                echo "Pushing changes to GitHub..."

                                git push \
                                    https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GITHUB_USERNAME}/${GIT_REPO_NAME}.git \
                                    HEAD:main

                                echo ""
                                echo "Deployment file pushed successfully."

                            fi
                        '''
                    }
                }
            }
        }
    }

    post {

        success {
            echo '========================================='
            echo 'PIPELINE COMPLETED SUCCESSFULLY'
            echo '========================================='
        }

        failure {
            echo '========================================='
            echo 'PIPELINE FAILED'
            echo '========================================='
            echo 'Check the stage logs above.'
            echo '========================================='
        }

        always {
            echo 'Cleaning Jenkins workspace...'
            cleanWs()
        }
    }
}




