
pipeline {

    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_IMAGE = 'shaunjohnmathew/spring-boot-app'
        DOCKER_CREDENTIALS = 'docker-cred'
        GITHUB_CREDENTIALS = 'github'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================='
                echo 'Checking out source code'
                echo '========================================='

                checkout scm

                sh '''
                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Project files:"
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                echo '========================================='
                echo 'Building Spring Boot application'
                echo '========================================='

                sh '''
                    echo "Maven version:"
                    mvn --version

                    echo ""
                    echo "Building application..."

                    mvn clean package
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {

                echo '========================================='
                echo 'Running SonarQube Analysis'
                echo '========================================='

                withSonarQubeEnv('sonarqube') {

                    sh '''
                        mvn sonar:sonar \
                            -Dsonar.projectKey=spring-boot-app \
                            -Dsonar.projectName="Spring Boot App" \
                            -Dsonar.host.url=$SONAR_HOST_URL
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {

                echo '========================================='
                echo 'Building Docker Image'
                echo '========================================='

                sh '''
                    echo "Docker version:"
                    docker --version

                    echo ""
                    echo "Building image..."

                    docker build \
                        -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                        -t ${DOCKER_IMAGE}:latest \
                        .

                    echo ""
                    echo "Docker image created successfully."

                    docker images | grep spring-boot-app
                '''
            }
        }

        stage('Push Docker Image') {
            steps {

                echo '========================================='
                echo 'Pushing Docker Image to Docker Hub'
                echo '========================================='

                script {

                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKER_CREDENTIALS}",
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {

                        sh '''
                            echo "Logging in to Docker Hub..."

                            echo "$DOCKER_PASSWORD" | docker login \
                                -u "$DOCKER_USERNAME" \
                                --password-stdin

                            echo "Pushing image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"

                            docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                            echo "Pushing latest image..."

                            docker push ${DOCKER_IMAGE}:latest

                            echo "Docker images pushed successfully."

                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Update Kubernetes Deployment') {
            steps {

                echo '========================================='
                echo 'Updating Kubernetes Deployment'
                echo '========================================='

                script {

                    withCredentials([
                        string(
                            credentialsId: "${GITHUB_CREDENTIALS}",
                            variable: 'GITHUB_TOKEN'
                        )
                    ]) {

                        sh '''
                            echo "Checking deployment file..."

                            ls -la spring-boot-app-manifests/

                            echo ""
                            echo "Updating Docker image tag..."

                            sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|" \
                                spring-boot-app-manifests/deployment.yml

                            echo ""
                            echo "Updated deployment:"
                            cat spring-boot-app-manifests/deployment.yml

                            echo ""
                            echo "Configuring Git..."

                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"

                            echo ""
                            echo "Adding deployment file..."

                            git add spring-boot-app-manifests/deployment.yml

                            echo ""
                            echo "Creating commit..."

                            git diff --cached --quiet || \
                                git commit \
                                -m "Update Spring Boot image tag to ${BUILD_NUMBER} [skip ci]"

                            echo ""
                            echo "Pushing changes to GitHub..."

                            git push \
                                https://${GITHUB_TOKEN}@github.com/shaunjohn-04/java-maven-sonar-argocd.git \
                                HEAD:main

                            echo ""
                            echo "Kubernetes deployment updated successfully."
                        '''
                    }
                }
            }
        }
    }

    post {

        success {
            echo '========================================='
            echo 'PIPELINE COMPLETED SUCCESSFULLY'
            echo '========================================='

            echo "Docker Image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"
        }

        failure {
            echo '========================================='
            echo 'PIPELINE FAILED'
            echo '========================================='

            echo 'Check the stage logs above.'
        }

        always {
            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }
    }
}


