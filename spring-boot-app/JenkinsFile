pipeline {

    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_IMAGE = 'shaunjohnmathew/spring-boot-app'
        DOCKER_CREDENTIALS = 'docker-cred'
        GITHUB_CREDENTIALS = 'github-credentials'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================='
                echo 'Checking out source code'
                echo '========================================='

                checkout scm

                sh '''
                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Project structure:"
                    ls -la

                    echo ""
                    echo "Spring Boot application:"
                    ls -la spring-boot-app

                    echo ""
                    echo "Kubernetes manifests:"
                    ls -la spring-boot-app-manifests
                '''
            }
        }


        stage('Build and Test') {
            steps {
                echo '========================================='
                echo 'Building Spring Boot application'
                echo '========================================='

                sh '''
                    echo "Java version:"
                    java -version

                    echo ""
                    echo "Maven version:"
                    mvn --version

                    echo ""
                    echo "Checking pom.xml:"
                    ls -la spring-boot-app/pom.xml

                    echo ""
                    echo "Building application..."

                    cd spring-boot-app

                    mvn clean package

                    echo ""
                    echo "Build completed successfully."

                    echo ""
                    echo "Generated files:"
                    ls -lh target/
                '''
            }
        }


       stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('sonarqube') {
            sh '''
                cd spring-boot-app

                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                    -Dsonar.projectKey=spring-boot-app \
                    -Dsonar.projectName="Spring Boot App" \
                    -Dsonar.host.url=$SONAR_HOST_URL
            '''
        }
    }
}


        stage('Build Docker Image') {
            steps {
                echo '========================================='
                echo 'Building Docker Image'
                echo '========================================='

                sh '''
                    echo "Docker version:"
                    docker --version

                    echo ""
                    echo "Building Docker image..."

                    docker build \
                        -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                        -t ${DOCKER_IMAGE}:latest \
                        spring-boot-app

                    echo ""
                    echo "Docker image built successfully."

                    docker images | grep spring-boot-app
                '''
            }
        }


        stage('Push Docker Image') {
            steps {
                echo '========================================='
                echo 'Pushing Docker Image to Docker Hub'
                echo '========================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "Logging in to Docker Hub..."

                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        echo ""
                        echo "Pushing versioned image..."

                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                        echo ""
                        echo "Pushing latest image..."

                        docker push ${DOCKER_IMAGE}:latest

                        echo ""
                        echo "Docker images pushed successfully."

                        docker logout
                    '''
                }
            }
        }


        stage('Update Kubernetes Deployment') {
            steps {
                echo '========================================='
                echo 'Updating Kubernetes Deployment'
                echo '========================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "Checking deployment file..."

                        ls -la spring-boot-app-manifests/

                        echo ""
                        echo "Deployment before update:"

                        cat spring-boot-app-manifests/deployment.yml

                        echo ""
                        echo "Updating Docker image..."

                        sed -i "s|image:.*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                            spring-boot-app-manifests/deployment.yml

                        echo ""
                        echo "Deployment after update:"

                        cat spring-boot-app-manifests/deployment.yml

                        echo ""
                        echo "Configuring Git..."

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add spring-boot-app-manifests/deployment.yml

                        git commit \
                            -m "Update Spring Boot image to ${BUILD_NUMBER} [skip ci]" \
                            || echo "No changes to commit"

                        echo ""
                        echo "Pushing deployment update to GitHub..."

                        git push \
                            https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/shaunjohn-04/java-maven-sonar-argocd.git \
                            HEAD:main

                        echo ""
                        echo "Kubernetes deployment file updated successfully."
                    '''
                }
            }
        }
    }


    post {

        success {
            echo '========================================='
            echo 'PIPELINE COMPLETED SUCCESSFULLY'
            echo '========================================='

            echo "Docker image:"
            echo "${DOCKER_IMAGE}:${BUILD_NUMBER}"

            echo "Latest image:"
            echo "${DOCKER_IMAGE}:latest"
        }

        failure {
            echo '========================================='
            echo 'PIPELINE FAILED'
            echo '========================================='

            echo 'Check the stage logs above.'
        }

        always {
            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }
    }
}

