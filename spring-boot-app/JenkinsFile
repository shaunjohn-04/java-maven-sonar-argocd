pipeline {
    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_IMAGE = 'shaunjohnmathew/spring-boot-app'
        DOCKER_CREDENTIALS = 'docker-cred'
        GITHUB_CREDENTIALS = 'github-credentials'
        SONARQUBE_SERVER = 'sonarqube'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================='
                echo 'Checking out source code'
                echo '========================================='

                checkout scm

                sh '''
                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Project files:"
                    ls -la

                    echo ""
                    echo "Spring Boot project:"
                    ls -la spring-boot-app

                    echo ""
                    echo "Checking pom.xml:"
                    ls -l spring-boot-app/pom.xml
                '''
            }
        }

        stage('Build and Test') {
            steps {
                echo '========================================='
                echo 'Building Spring Boot application'
                echo '========================================='

                sh '''
                    echo "Maven version:"
                    mvn --version

                    echo ""
                    echo "Building application..."

                    cd spring-boot-app

                    mvn clean package

                    echo ""
                    echo "Build completed successfully."

                    echo ""
                    echo "Generated files:"
                    ls -lh target/
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '========================================='
                echo 'Running SonarQube Analysis'
                echo '========================================='

                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    sh '''
                        cd spring-boot-app

                        mvn sonar:sonar \
                            -Dsonar.projectKey=spring-boot-app \
                            -Dsonar.projectName="Spring Boot App" \
                            -Dsonar.host.url="$SONAR_HOST_URL"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '========================================='
                echo 'Building Docker Image'
                echo '========================================='

                sh '''
                    echo "Docker version:"
                    docker --version

                    echo ""
                    echo "Building image..."

                    docker build \
                        -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                        -t ${DOCKER_IMAGE}:latest \
                        spring-boot-app

                    echo ""
                    echo "Docker image built successfully."

                    docker images | grep spring-boot-app
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                echo '========================================='
                echo 'Pushing Docker Image to Docker Hub'
                echo '========================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        echo "Pushing version ${BUILD_NUMBER}..."

                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                        echo "Pushing latest..."

                        docker push ${DOCKER_IMAGE}:latest

                        docker logout

                        echo "Docker images pushed successfully."
                    '''
                }
            }
        }

        stage('Update Kubernetes Deployment') {
            steps {
                echo '========================================='
                echo 'Updating Kubernetes Deployment'
                echo '========================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "Checking deployment file..."

                        ls -l spring-boot-app-manifests/

                        echo ""
                        echo "Current image:"
                        grep "image:" spring-boot-app-manifests/deployment.yml || true

                        echo ""
                        echo "Updating image to:"
                        echo "${DOCKER_IMAGE}:${BUILD_NUMBER}"

                        sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" \
                            spring-boot-app-manifests/deployment.yml

                        echo ""
                        echo "Updated image:"
                        grep "image:" spring-boot-app-manifests/deployment.yml

                        git config user.email "jenkins@localhost"
                        git config user.name "Jenkins"

                        git add spring-boot-app-manifests/deployment.yml

                        git commit \
                            -m "Update Spring Boot image to ${BUILD_NUMBER} [skip ci]" \
                            || echo "No changes to commit"

                        git push \
                            https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/${GIT_USERNAME}/java-maven-sonar-argocd.git \
                            HEAD:main

                        echo ""
                        echo "Kubernetes deployment file updated successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '========================================='
            echo 'PIPELINE COMPLETED SUCCESSFULLY'
            echo '========================================='
        }

        failure {
            echo '========================================='
            echo 'PIPELINE FAILED'
            echo '========================================='
            echo 'Check the stage logs above.'
        }

        always {
            echo 'Cleaning Jenkins workspace...'
            cleanWs()
        }
    }
}


